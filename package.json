{
  "name": "cue",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "description": "Cue — client-side PWA media player",
  "scripts": {
    "dev": "vite",
    "build:sw": "node scripts/build-sw.mjs",
    "build": "tsc --noEmit && vite build && npm run build:sw && workbox injectManifest workbox-config.cjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "node --test tests/unit/*.test.js"
  },
  "dependencies": {
    "esbuild": "^0.21.5",
    "postcss": "^8.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "workbox-cli": "^7.0.0",
    "workbox-core": "^7.0.0",
    "workbox-precaching": "^7.0.0",
    "workbox-range-requests": "^7.0.0",
    "workbox-routing": "^7.0.0",
    "workbox-strategies": "^7.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
