{
  "name": "cue",
  "version": "0.2.0",
  "private": true,
  "description": "Cue — client-side PWA media player",
  "scripts": {
    "dev": "vite",
    "build": "vite build && esbuild src/sw.js --bundle --format=iife --target=es2020 --outfile=.build/sw.js && workbox injectManifest workbox-config.js",
    "preview": "vite preview",
    "test": "node --test tests/unit/*.test.js"
  },
  "dependencies": {
    "esbuild": "^0.21.5",
    "postcss": "^8.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "workbox-cli": "^7.0.0",
    "workbox-core": "^7.0.0",
    "workbox-precaching": "^7.0.0",
    "workbox-range-requests": "^7.0.0",
    "workbox-routing": "^7.0.0",
    "workbox-strategies": "^7.0.0"
  }
}
